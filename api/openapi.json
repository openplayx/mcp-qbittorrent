{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenPlayX BitTorrent API",
    "version": "1.0.0",
    "description": "Restricted HTTP API over a pinned qBittorrent engine. Callers use logical destination refs and service task IDs; engine credentials, SIDs, full magnets and absolute paths are never returned.",
    "license": {
      "name": "GNU GPL v3 (see COPYING)"
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Process liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Database and engine readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",

    "/api/v1/torrents/{id}/files/{file_id}/content": {
      "get": {
        "summary": "Read a complete file (Range supported). Only when capabilities.file_content is true.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "description": "Engine torrent hash (v1 info hash, or the 40-hex id of a v2-only torrent)."
          },
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^f[0-9]+$"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File bytes"
          },
          "206": {
            "description": "Partial content"
          },
          "416": {
            "description": "Range not satisfiable"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "head": {
        "summary": "Size and type of a complete file",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "description": "Engine torrent hash (v1 info hash, or the 40-hex id of a v2-only torrent)."
          },
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^f[0-9]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Headers only"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "Error": {
        "description": "Error with stable code, request ID and retryability",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "request_id",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "detail": {
                "type": "object"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Ready": {
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "engine": {
            "type": "boolean"
          }
        }
      },
      "Destination": {
        "type": "object",
        "properties": {
          "destination_ref": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "free_bytes": {
            "type": "integer"
          },
          "max_task_bytes": {
            "type": "integer"
          }
        }
      },
      "Destinations": {
        "type": "object",
        "properties": {
          "destinations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Destination"
            }
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "service": {
            "type": "object"
          },
          "engine": {
            "type": "object"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "magnet",
                "torrent_file"
              ]
            }
          },
          "torrent_versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selection_presets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state_storage": {
            "type": "string",
            "enum": [
              "none"
            ]
          },
          "all_engine_torrents": {
            "type": "boolean"
          },
          "file_content": {
            "type": "boolean"
          },
          "webui": {
            "type": "boolean"
          },
          "streaming_while_downloading": {
            "type": "boolean"
          },
          "metadata_only_guarantee": {
            "type": "boolean",
            "description": "false: a magnet may transfer a little payload data before it is stopped"
          },
          "limits": {
            "type": "object"
          },
          "seeding": {
            "type": "object"
          },
          "destinations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Destination"
            }
          }
        }
      },
      "Input": {
        "type": "object",
        "properties": {
          "input_ref": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "torrent_version": {
            "type": "string",
            "enum": [
              "v1",
              "v2",
              "hybrid"
            ]
          },
          "file_count": {
            "type": "integer"
          },
          "total_size": {
            "type": "integer"
          },
          "private": {
            "type": "boolean"
          },
          "removed_addresses": {
            "type": "object",
            "description": "Nested addresses dropped by the network policy (the input is kept)",
            "properties": {
              "private_or_local_address": {
                "type": "integer"
              },
              "unsupported_address": {
                "type": "integer"
              }
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlanRequest": {
        "type": "object",
        "required": [
          "source",
          "destination_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "magnet",
                  "input"
                ]
              },
              "magnet": {
                "type": "string",
                "pattern": "^magnet:\\?"
              },
              "input_ref": {
                "type": "string"
              }
            }
          },
          "destination_ref": {
            "type": "string"
          },
          "selection_preset": {
            "type": "string",
            "enum": [
              "all",
              "video"
            ],
            "default": "all"
          },
          "auto_start": {
            "type": "boolean",
            "default": true
          },
          "download_limit": {
            "type": "integer",
            "minimum": 0,
            "description": "bytes/s, 0 = administrator ceiling"
          },
          "upload_limit": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Plan": {
        "type": "object",
        "properties": {
          "plan_ref": {
            "type": "string",
            "description": "Opaque signed token; valid until expires_at or a server restart"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "input_kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "torrent_version": {
            "type": "string"
          },
          "metadata": {
            "type": "string",
            "enum": [
              "known",
              "unknown"
            ]
          },
          "total_size": {
            "type": "integer"
          },
          "selected_size": {
            "type": "integer"
          },
          "file_count": {
            "type": "integer"
          },
          "files_preview": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "size": {
                  "type": "integer"
                },
                "selected": {
                  "type": "boolean"
                }
              }
            }
          },
          "destination": {
            "$ref": "#/components/schemas/Destination"
          },
          "selection_preset": {
            "type": "string"
          },
          "auto_start": {
            "type": "boolean"
          },
          "download_limit": {
            "type": "integer"
          },
          "upload_limit": {
            "type": "integer"
          },
          "trackers": {
            "type": "integer",
            "description": "trackers kept after filtering"
          },
          "removed_addresses": {
            "type": "object",
            "description": "Nested addresses dropped by the network policy (the input is kept)",
            "properties": {
              "private_or_local_address": {
                "type": "integer"
              },
              "unsupported_address": {
                "type": "integer"
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "e.g. metadata_unknown, addresses_removed, no_trackers_dht_only, private_torrent"
          }
        }
      },
      "CreateRequest": {
        "type": "object",
        "required": [
          "plan_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "plan_ref": {
            "type": "string"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "metadata_pending",
              "queued",
              "downloading",
              "paused",
              "checking",
              "stalled",
              "completed",
              "seeding",
              "error"
            ]
          },
          "hold_reason": {
            "type": "string",
            "enum": [
              "awaiting_start",
              "quota_exceeded",
              "disk_low",
              "no_files_match_preset"
            ]
          },
          "error_code": {
            "type": "string"
          },
          "torrent_version": {
            "type": "string"
          },
          "destination_ref": {
            "type": "string"
          },
          "added_via": {
            "type": "string",
            "enum": [
              "app",
              "other"
            ]
          },
          "progress": {
            "type": "number",
            "description": "0..1 over selected files"
          },
          "selected_size": {
            "type": "integer"
          },
          "total_size": {
            "type": "integer"
          },
          "completed_bytes": {
            "type": "integer"
          },
          "downloaded_bytes": {
            "type": "integer"
          },
          "uploaded_bytes": {
            "type": "integer"
          },
          "download_speed": {
            "type": "integer"
          },
          "upload_speed": {
            "type": "integer"
          },
          "download_limit": {
            "type": "integer"
          },
          "upload_limit": {
            "type": "integer"
          },
          "seeds": {
            "type": "integer"
          },
          "peers": {
            "type": "integer"
          },
          "ratio": {
            "type": "number"
          },
          "eta_seconds": {
            "type": "integer"
          },
          "metadata_known": {
            "type": "boolean"
          },
          "payload_complete": {
            "type": "boolean"
          },
          "selected_files_complete": {
            "type": "boolean"
          },
          "seeding": {
            "type": "boolean"
          },
          "added_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TaskList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        }
      },
      "File": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Relative to the torrent, never an absolute path"
          },
          "size": {
            "type": "integer"
          },
          "progress": {
            "type": "number"
          },
          "selected": {
            "type": "boolean"
          },
          "complete": {
            "type": "boolean"
          },
          "is_video": {
            "type": "boolean"
          },
          "content_available": {
            "type": "boolean"
          }
        }
      },
      "Files": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "metadata_known": {
            "type": "boolean"
          },
          "files_revision": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          }
        }
      },
      "SelectionRequest": {
        "type": "object",
        "required": [
          "expected_revision"
        ],
        "additionalProperties": false,
        "description": "Exactly one of preset or file_ids.",
        "properties": {
          "expected_revision": {
            "type": "string"
          },
          "preset": {
            "type": "string",
            "enum": [
              "all",
              "video"
            ]
          },
          "file_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20000
          }
        }
      },
      "LimitsRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "download_limit": {
            "type": "integer",
            "minimum": 0
          },
          "upload_limit": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "RemovePlanRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "delete_files": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "RemovePlan": {
        "type": "object",
        "properties": {
          "plan_ref": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "task_name": {
            "type": "string"
          },
          "delete_files": {
            "type": "boolean"
          },
          "files_on_disk": {
            "type": "integer"
          },
          "bytes_on_disk": {
            "type": "integer"
          },
          "added_via": {
            "type": "string"
          },
          "stops_seeding": {
            "type": "boolean"
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RemoveRequest": {
        "type": "object",
        "required": [
          "plan_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "plan_ref": {
            "type": "string"
          }
        }
      },
      "RemoveResult": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "removed": {
            "type": "boolean"
          },
          "data_deleted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemovePlanRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Remove plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemovePlan"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {

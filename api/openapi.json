    "/api/v1/torrents/{id}/remove": {
      "post": {
        "summary": "Apply a remove plan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "description": "Engine torrent hash (v1 info hash, or the 40-hex id of a v2-only torrent)."
          }
        ],
        "requestBody": {

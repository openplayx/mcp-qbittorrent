{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenPlayX BitTorrent API",
    "version": "2.0.0",
    "license": {
      "name": "GNU GPL v3 (see COPYING)"
    },
    "description": "Stateless HTTP API over a pinned qBittorrent engine: every read is live from the engine and all engine torrents (including WebUI-added ones) are listed and controllable. Plans and removal confirmations are signed tokens. Service endpoints live under /api/ (except /api/v2/, the engine WebUI's own API); other paths serve the engine WebUI through a guarded proxy when enabled. Engine credentials, SIDs, full magnets and absolute paths are never returned."
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/api/healthz": {
      "get": {
        "summary": "Process liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/readyz": {
      "get": {
        "summary": "Engine reachable (probed live)",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This document",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1"
          }
        }
      }
    },
    "/api/docs": {
      "get": {
        "summary": "Human-readable API docs",
        "security": [],
        "responses": {
          "200": {
            "description": "HTML"
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "summary": "Engine version, inputs, limits, destinations",
        "responses": {
          "200": {
            "description": "Capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/destinations": {
      "get": {
        "summary": "Logical destinations with free space",
        "responses": {
          "200": {
            "description": "Destinations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Destinations"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/torrent-inputs": {
      "post": {
        "summary": "Upload a size-limited .torrent; kept in memory briefly, returns input_ref",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-bittorrent": {
              "schema": {
                "type": "string",
                "contentMediaType": "application/x-bittorrent"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "torrent": {
                    "type": "string",
                    "contentMediaType": "application/x-bittorrent"
                  }
                },
                "required": [
                  "torrent"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Input"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/torrent-plans": {
      "post": {
        "summary": "Validate a magnet or input_ref, destination and strategy; returns a signed, expiring plan_ref. Contacts no peers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/torrents": {
      "post": {
